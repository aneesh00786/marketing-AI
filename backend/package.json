{
  "name": "tradesage-ai-backend",
  "version": "1.0.0",
  "description": "TradeSage AI - Multi-Tenant Workforce SaaS Backend (Express + MySQL + Telnyx)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "migrate": "node db/migrate.js",
    "migrate:status": "node db/migrate.js --status",
    "worker": "node workers/socialWorker.js",
    "set-password": "node scripts/setPassword.js",
    "test": "node --test --test-concurrency=1 tests/",
    "seed:demo": "node scripts/seedDemoWorkspace.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "imapflow": "^2.5.5",
    "mailparser": "^3.9.46",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.1.7",
    "sqlite3": "^5.1.7",
    "undici": "^6.29.1",
    "zod": "^3.25.76"
  }
}
