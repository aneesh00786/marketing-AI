# Marketech.ai - Environment Configuration

# Server Port
PORT=8000

# ============================================================
# DATABASE SELECTION: 'mysql' (Default) or 'sqlite'
# ============================================================
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tradesage

# To run on SQLite without MySQL:
# DB_CLIENT=sqlite

# ============================================================
# TELNYX ALL-IN-ONE VOICE AI (Pay-as-you-go, ~$0.05/min)
# ============================================================
TELNYX_API_KEY=KEY01...
TELNYX_PHONE_NUMBER=+1 (800) 555-SAGE
# Public key that verifies Telnyx webhook signatures (Mission Control > Account Settings >
# Keys & Credentials > Public Key; base64). Without it /api/telnyx/inbound and /dialogue reject every request.
TELNYX_PUBLIC_KEY=
# Browser calling (the phone icon). Separate from TELNYX_API_KEY so it switches on nothing else.
# Calling works only when the key, connection and caller ID are all set.
TELNYX_WEBRTC_API_KEY=
TELNYX_WEBRTC_CONNECTION_ID=
TELNYX_CALLER_ID=
TELNYX_CALLER_NAME=
# Speech-to-text model for call transcripts. Leave empty for openai/whisper-large-v3-turbo (multi-language).
TELNYX_TRANSCRIPTION_MODEL=

# Strict Monthly Infrastructure Budget Cap
MONTHLY_BUDGET_CAP=10.00

# ============================================================
# SECURITY (required)
# ============================================================
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts social OAuth tokens and mailbox passwords at rest. Do not change it after tokens are stored.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Public URL of this API (OAuth redirect URLs are built from it; must be HTTPS in production)
APP_BASE_URL=http://localhost:8000
# Where the browser app runs (used for CORS and OAuth return redirects)
FRONTEND_URL=http://localhost:4200
# Extra comma-separated CORS origins, if any
CORS_ORIGINS=
# Reverse proxy. Set to 1 ONLY when exactly one reverse proxy you control (e.g. nginx on the same
# server) sits in front of the API, adds X-Forwarded-For / X-Forwarded-Proto, and the API port is not
# reachable from the internet directly. The client IP is then the address that proxy reports;
# anything a client puts in X-Forwarded-For before it is ignored. Leave empty when the API is reached
# directly: forwarded headers are then ignored completely. With a CDN or load balancer in front of the
# proxy (two hops) 1 is NOT correct (every client would appear as the CDN); that needs a code change.
# Client IPs drive the per-IP rate limits (sign-in, API, email tracking pixels/links).
# Rate limits are kept in memory per API process: with more than one API instance they need a shared
# store (e.g. Redis) — see docs/DEPLOYMENT_SAFETY.md section 2a.
TRUST_PROXY=
# Interface the API listens on. Behind nginx on the same server use 127.0.0.1 so the API port is not
# reachable from the network at all (default 0.0.0.0: all interfaces).
LISTEN_HOST=
# production: the API and worker refuse to start unless APP_BASE_URL is public https and
# SOCIAL_MEDIA_STORAGE_DIR is an absolute, writable folder; migrations need --backup=<dump>;
# the database is built only by migrations. See docs/DEPLOYMENT_SAFETY.md.
NODE_ENV=
# Product Emails (product -> leads -> email batches) is hidden and inactive unless set to 1.
# Unsubscribe links in emails already sent keep working either way.
PRODUCT_EMAILS_ENABLED=
# Email tracking. ZeptoMail delivery/bounce/open/click webhooks are refused (404) unless set to 1.
# Leave EMPTY until the event format and signature have been confirmed with a captured test event
# on staging (docs/EMAIL_TRACKING_STAGING.md). Never enable in production without that sign-off.
ZEPTOMAIL_WEBHOOKS_ENABLED=
# Days to keep tracking events and tracked-link records (default 395, minimum 30).
MAIL_TRACKING_RETENTION_DAYS=
# STAGING ONLY — never set DEPLOYMENT_ENV in production. With DEPLOYMENT_ENV=staging the API and worker
# refuse to start if they could act on production (see docs/STAGING_RUNBOOK.md).
DEPLOYMENT_ENV=
PRODUCTION_DB_NAME=tradesage
# Required on staging: production DB server @@hostname and production app hostname (refuses without them)
PRODUCTION_DB_HOSTNAME=
PRODUCTION_APP_HOST=
# External account ids of dedicated test accounts / sender address of a test mailbox (comma-separated)
STAGING_ALLOWED_SOCIAL_ACCOUNTS=
STAGING_ALLOWED_MAILBOXES=
STAGING_ALLOW_ZOHO=
STAGING_ALLOW_ZEPTOMAIL=
# Uploaded social media images/videos. Absolute path OUTSIDE the code folder, shared by the API and the
# worker, included in backups. Served publicly at <APP_BASE_URL>/api/v1/social/media-files/<opaque id>.
SOCIAL_MEDIA_STORAGE_DIR=
SOCIAL_MEDIA_MAX_IMAGE_MB=8
SOCIAL_MEDIA_MAX_VIDEO_MB=500
SOCIAL_MEDIA_WORKSPACE_QUOTA_MB=5120
# Shared secret the ElevenLabs agent sends as X-Tool-Secret when calling /api/tools/* without a user session
TOOL_WEBHOOK_SECRET=

# ============================================================
# EMAIL & VOICE (moved out of source code)
# ============================================================
ZEPTOMAIL_TOKEN=
# Zoho Campaigns (optional here). Normally an Owner/Admin enters the Zoho Client ID and Secret in
# Mail Center > Settings > Zoho Campaigns (stored per workspace, encrypted with
# SOCIAL_TOKEN_ENCRYPTION_KEY). These two values are only the fallback for workspaces that have not:
# a server-based client from https://api-console.zoho.com with redirect URI
# <APP_BASE_URL>/api/v1/mail/zoho/callback and multi-DC enabled. Each workspace connects its own Zoho
# account; refresh tokens are stored encrypted too.
ZOHO_CAMPAIGNS_CLIENT_ID=
ZOHO_CAMPAIGNS_CLIENT_SECRET=
# Email template images/fonts (uploaded HTML/ZIP templates). Stored on local disk outside the web
# root; served publicly at <APP_BASE_URL>/api/v1/mail/assets/<opaque id> so recipients and Zoho can
# load them (use a public https APP_BASE_URL and a persistent, backed-up directory in production).
MAIL_ASSET_STORAGE_DIR=
MAIL_ASSET_WORKSPACE_QUOTA_MB=200
# Upload limits for templates.
MAIL_TEMPLATE_MAX_HTML_KB=1024
MAIL_TEMPLATE_ZIP_MAX_MB=10
MAIL_TEMPLATE_ZIP_MAX_EXPANDED_MB=30
MAIL_TEMPLATE_ZIP_MAX_ENTRIES=200
MAIL_TEMPLATE_ZIP_MAX_FILE_MB=5
MAIL_TEMPLATE_ZIP_MAX_RATIO=100
# Product emails (marketing): recipients per batch, and emails the background worker sends per tick.
MAIL_BATCH_MAX_RECIPIENTS=100
MAIL_BATCH_EMAILS_PER_TICK=10
# Product emails are marketing: never sent through ZeptoMail (transactional only); they need an SMTP
# mailbox approved for marketing by an Owner/Admin in Mail Settings.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ============================================================
# AI PROVIDERS (at least one is needed for campaign generation)
# ============================================================
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_MODEL=llama3
# Hard monthly cap on AI requests per workspace, and an optional per-request cost estimate (USD)
SOCIAL_AI_MONTHLY_REQUEST_LIMIT=500
AI_COST_PER_REQUEST_USD=0

# ============================================================
# SOCIAL PROVIDERS (Social Media Marketing hub) — see docs/SOCIAL_MEDIA_HUB.md
# ============================================================
# Meta (Facebook Pages + Instagram Professional) — developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=
# LinkedIn Pages (Community Management API product required)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202606
# YouTube (Google Cloud OAuth client, YouTube Data API v3 enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Worker poll interval (ms)
SOCIAL_WORKER_POLL_MS=5000

# AI Lead Discovery map view (optional): a BROWSER key for the Maps JavaScript API, separate from the
# server's Places key. Restrict it in Google Cloud to this site's address (e.g. http://localhost:8000/*).
GOOGLE_MAPS_BROWSER_KEY=
