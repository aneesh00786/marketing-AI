# TradeSage AI - Environment Configuration

# Server Port
PORT=8000

# ============================================================
# DATABASE SELECTION: 'mysql' (Default) or 'sqlite'
# ============================================================
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tradesage

# To run on SQLite without MySQL:
# DB_CLIENT=sqlite

# ============================================================
# TELNYX ALL-IN-ONE VOICE AI (Pay-as-you-go, ~$0.05/min)
# ============================================================
TELNYX_API_KEY=KEY01...
TELNYX_PHONE_NUMBER=+1 (800) 555-SAGE

# Strict Monthly Infrastructure Budget Cap
MONTHLY_BUDGET_CAP=10.00

# ============================================================
# SECURITY (required)
# ============================================================
# Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts social OAuth tokens and mailbox passwords at rest. Do not change it after tokens are stored.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Public URL of this API (OAuth redirect URLs are built from it; must be HTTPS in production)
APP_BASE_URL=http://localhost:8000
# Where the browser app runs (used for CORS and OAuth return redirects)
FRONTEND_URL=http://localhost:4200
# Extra comma-separated CORS origins, if any
CORS_ORIGINS=
# Shared secret the ElevenLabs agent sends as X-Tool-Secret when calling /api/tools/* without a user session
TOOL_WEBHOOK_SECRET=

# ============================================================
# EMAIL & VOICE (moved out of source code)
# ============================================================
ZEPTOMAIL_TOKEN=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ============================================================
# AI PROVIDERS (at least one is needed for campaign generation)
# ============================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_MODEL=llama3
# Hard monthly cap on AI requests per workspace, and an optional per-request cost estimate (USD)
SOCIAL_AI_MONTHLY_REQUEST_LIMIT=500
AI_COST_PER_REQUEST_USD=0

# ============================================================
# SOCIAL PROVIDERS (Social Media Marketing hub) — see docs/SOCIAL_MEDIA_HUB.md
# ============================================================
# Meta (Facebook Pages + Instagram Professional) — developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_WEBHOOK_VERIFY_TOKEN=
# LinkedIn Pages (Community Management API product required)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202606
# YouTube (Google Cloud OAuth client, YouTube Data API v3 enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Worker poll interval (ms)
SOCIAL_WORKER_POLL_MS=5000
